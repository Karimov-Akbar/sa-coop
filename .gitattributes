* text=auto
# Windows tools and the files players open in Notepad keep CRLF
*.bat text eol=crlf
*.ps1 text eol=crlf
package/** text eol=crlf
*.png binary
*.jpg binary
# the animation packs: whole bytes, never line endings
*.ifp binary
# the skin packs' models and textures too: package/** made them text, and the commit took a byte 0x0D out of each CR LF
*.dff binary
*.txd binary
# and the skins' voices (coop/voices: Ogg Vorbis and the lines' packs)
*.ogg binary
*.pak binary
